# ============================================================
# 環境變數範本（.env.example）
#
# 使用方式：
#   1. 複製此檔為 .env
#   2. 修改 「必填」 變數為實際值（勿使用 change-me-* 提示字樣）
#   3. 可選變數可維持預設、或根據需求覆寫
#   4. docker compose 啟動時會自動讀 .env 並注入到 service
#
# 本檔是 contract source of truth，參考 contracts/env-variables.md
# ============================================================

# ============================================================
# 【必填】安全認證 & 時區 (4 個變數)
#
# 以下變數 MUST 設定；docker compose 啟動時若缺少會 abort
# 用 compose.yaml 的 ${VAR:?must set VAR} 語法強制檢查
# ============================================================

# PostgreSQL 超級使用者密碼
# Consumer: postgres image、new-admin-rust-api (DATABASE_URL)、migration
# 建議：≥12 字元，含大小寫、數字、符號
POSTGRES_PASSWORD=change-me-strong-password

# Redis 存取密碼
# Consumer: redis image (--requirepass)、new-admin-rust-api (REDIS_URL)
# 建議：≥16 字元，隨機產生
REDIS_PASSWORD=change-me-redis-password
# Note：redis container 之 main process argv 仍會在 `docker top` 暴露
# REDIS_PASSWORD 之明文值（redis-server `--requirepass` CLI flag 設計）。
# 本專案接受此 limitation；future hardening 可改用 ACL config file。
# （healthcheck argv 在 1-I1 hotfix 已修為 CMD-SHELL form 不暴露）

# JWT 簽署密鑰
# Consumer: new-admin-rust-api (HS256 簽 access token)
# 必須：≥32 字元（HS256 安全下限）
JWT_SECRET=change-me-jwt-secret-at-least-32-chars

# 時區（IANA timezone）
# Consumer: postgres、redis、new-admin-rust-api 三個 service
# 例：Asia/Taipei、UTC、Europe/London
# 為何強制：跨地區部署時、log timestamp 對齊、database 內 TIMESTAMP 行為一致性
TZ=Asia/Taipei

# ============================================================
# 【可選】應用程式設定 (10 個變數)
#
# 以下變數有預設值；docker compose 啟動時若缺少會使用 fallback
# 用 compose.yaml 的 ${VAR:-default} 語法提供 fallback
# ============================================================

# PostgreSQL 資料庫名
# Consumer: postgres image、new-admin-rust-api、migration
# Default: new_admin
POSTGRES_DB=new_admin

# PostgreSQL 超級使用者名稱
# Consumer: postgres image、new-admin-rust-api、migration
# Default: admin
# 注意：dev 環境用 admin 簡化；prod 應設定為應用程式專用使用者
POSTGRES_USER=admin

# Web 應用對外 port
# Consumer: new-admin-base-web (nginx 監聽)
# Default: 8080
WEB_PORT=8080

# Rust 應用 log level
# Consumer: new-admin-rust-api (RUST_LOG env)
# Default: info
# 選項：trace / debug / info / warn / error
RUST_LOG=info

# JWT access token TTL（秒）
# Consumer: new-admin-rust-api (token 簽發時計算)
# Default: 7200 (2 小時)
JWT_EXPIRE=7200

# Refresh token TTL（秒）
# Consumer: new-admin-rust-api (refresh handler + login 寫入 sys_tokens.expires_at)
# Default: 1209600 (14 天)
# 注意：實際 binding 為 APP_JWT_REFRESH_TOKEN_EXPIRE（admin-rust-api 透過 APP_ prefix + 嵌套 JwtConfig 讀取）；
# 上面 JWT_EXPIRE 等 sibling 沒有 APP_ 前綴是 feature 1 pre-existing 樣式，feature 6 envsubst merge 後將統一前綴。
APP_JWT_REFRESH_TOKEN_EXPIRE=1209600

# Sea-ORM 資料庫連線池上限
# Consumer: new-admin-rust-api (pool 初始化)
# Default: 10
# 說明：admin tool 流量低，10 個連線足夠；高流量場景可酌增
DATABASE_MAX_CONNECTIONS=10

# JWT 簽發者 URL（issuer claim）
# 必填：必須改為真實 issuer URL，admin-api entrypoint.sh 會拒以下 sentinel：
#   - "" (空字串)
#   - "https://github.com/your-org/new-admin"
#   - "change-me-issuer-url"（本 placeholder 值，部署前必須改）
# 例：https://auth.my-company.example.com
APP_JWT_ISSUER=change-me-issuer-url

# Web 應用瀏覽器 title
# Consumer: new-admin-base-web Dockerfile (build-time ARG)
# Default: NewAdmin
# 注意：改此變數需重新 build image（非 runtime 環境變數）
VITE_APP_TITLE=NewAdmin

# 路由模式：前端定義 vs 後端推送
# Consumer: new-admin-base-web Dockerfile (build-time ARG)
# Default: static
# 選項：
#   - static: 路由在前端 .ts 定義（簡易，不可動）
#   - dynamic: 路由由後端 API 推送（靈活，需後端支援）
VITE_AUTH_ROUTE_MODE=static

# 靜態模式下的超級管理員角色代碼
# Consumer: new-admin-base-web (前端授權邏輯)
# Default: R_SUPER
# 說明：當 VITE_AUTH_ROUTE_MODE=static 時，此角色代碼被視為 super role
# （檢查 user.roles 是否包含此代碼）
VITE_STATIC_SUPER_ROLE=R_SUPER
